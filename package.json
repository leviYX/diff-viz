    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^18.3.1",
